# Copia este archivo como .env y completa los valores. El .env nunca se sube al repo.
# Codex usa la sesión local de ChatGPT, sin API keys. Vacío: buscar codex en PATH.
# En macOS con ChatGPT: /Applications/ChatGPT.app/Contents/Resources/codex-cli/bin/codex
CODEX_BIN=
# Modelos observados en esta cuenta; el conector comprueba disponibilidad antes de usarlos.
CODEX_MODELO_GENERADOR=gpt-6.2-sol
CODEX_MODELO_CLASIFICADOR=gpt-6.2-sol
CODEX_MODELO_JUEZ=gpt-6.2-astra
# Plazo del proceso de inferencia (10–600 segundos). No cambia el timeout de las herramientas.
CODEX_TIMEOUT_MODELO_S=240

# Modelos locales: vacío conserva CUDA/CPU. En Apple Silicon se puede elegir mps y float16.
# Los lotes vacíos conservan el valor del dispositivo; no alteran los modelos ni el umbral.
TICKETS_DISPOSITIVO=
TICKETS_PRECISION=
TICKETS_PRECISION_RERANKER=
TICKETS_LOTE_EMBEDDINGS=
TICKETS_LOTE_RERANKER=
# Opcional experimental MPS: solo true/false; false no cambia la gestión previa de caché.
TICKETS_VACIAR_CACHE_MPS=false
# Evita que una operación MPS no soportada cambie silenciosamente a CPU.
PYTORCH_ENABLE_MPS_FALLBACK=0

# Base de datos local de Docker (docker-compose.yml)
POSTGRES_USER=tickets
POSTGRES_PASSWORD=
POSTGRES_DB=tickets_rag
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5433

# Roles de las herramientas; scripts/preparar_bd.py genera las claves si faltan
TICKETS_LECTURA_PASSWORD=
TICKETS_ACCIONES_PASSWORD=

# LangGraph Studio local: desactiva las trazas a LangSmith.
# Codex sigue enviando el contexto necesario al modelo; usa solo datos públicos o ficticios.
LANGSMITH_TRACING=false
