{"id": "R04", "respuesta": {"answer": "1. Informa a la guardia que el mantenimiento de SIRA es semanal, no nocturno diario: va del domingo a las 22:00 al lunes a las 02:00.\n2. El código de error de mantenimiento es ERP-503. ERP-401 indica que la sesión expiró.", "sources": [{"source": "manual_mesa_ayuda_v2026-2.pdf", "page": 12, "chunk_id": "F1-2026-2-c029"}], "abstained": false, "tool_used": "search_docs", "needs_human_review": false}, "ruta": null, "herramientas": ["search_docs"], "revision": [], "candidatos": ["F1-2026-2-c029", "F1-2026-2-c030", "F1-2026-2-c031", "F1-2026-2-c035", "F1-2026-2-c014"], "candidatos_todos": ["F1-2026-2-c029", "F1-2026-2-c030", "F1-2026-2-c031", "F1-2026-2-c035", "F1-2026-2-c014"], "solicitudes": [], "solicitudes_en_pausa": [], "degradado": false, "segundos": 10.776, "costo_usd": 0.0, "motivo_abstencion": null, "proveedor": "codex_subscription", "uso": [{"modelo": "gpt-6.2-sol", "entrada": 6620, "salida": 106}], "segundos_intento_final": 10.772, "latencia_medicion": "tiempo activo acumulado; excluye espera entre reanudaciones", "fallos_modelo": [], "calificacion": {"pasa": true, "detalle": {"responde": true}, "ruta_correcta": null}, "metricas": {"recall_at_5": 1.0, "mrr": 1.0, "precision_at_5": 0.2, "redundancia": 0.0}, "accion_sin_aprobacion": 0, "contrato_valido": true, "juez": {"cobertura": 1.0, "incorrectos": 0, "precision_citas": 1.0, "relevancia": 1.0, "comentario": "La respuesta precisa que la ventana semanal va del domingo a las 22:00 al lunes a las 02:00 y distingue ERP-503 (mantenimiento) de ERP-401 (sesión expirada). El fragmento respalda ambas aclaraciones.", "costo_usd": 0.0, "detalle": {"hechos_presentes": [1, 2], "citas": {"F1-2026-2-c029": true}, "relevancia_1_5": 5, "uso": {"modelo": "gpt-6.2-astra", "llamadas": 1, "tokens_entrada": 6199, "tokens_salida": 181, "tokens_cache_lectura": 3968, "tokens_cache_escritura": 0, "costo_api_incremental_usd": 0.0}}}, "ragas": {"fidelidad": 1.0, "precision_contexto": 1.0, "error_ra